{
  "name": "plain-text-system",
  "version": "1.0.0",
  "description": "A small CSS system for documents that want to read like documents. Monospace carries structure, a second face carries language, and separation comes from rules and space rather than from cards. Nine rules, no dependencies, no build step.",
  "keywords": [
    "css",
    "design-system",
    "classless",
    "typography",
    "monospace",
    "dark-mode",
    "accessibility",
    "wcag",
    "print-stylesheet",
    "no-dependencies"
  ],
  "homepage": "https://style.aarontaylor.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarontaylor-dev/plain-text-system.git"
  },
  "bugs": {
    "url": "https://github.com/aarontaylor-dev/plain-text-system/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aaron Taylor",
    "url": "https://aarontaylor.me"
  },
  "contributors": [
    {
      "name": "Aaron Taylor",
      "url": "https://github.com/aarontaylor-dev"
    }
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "style": "plain-text.css",
  "exports": {
    ".": "./plain-text.css",
    "./plain-text.css": "./plain-text.css",
    "./skins": "./plain-text-skins.css",
    "./plain-text-skins.css": "./plain-text-skins.css",
    "./theme": "./plain-text-theme.js",
    "./plain-text-theme.js": "./plain-text-theme.js",
    "./measure": "./src/measure.js",
    "./system.md": "./system.md",
    "./package.json": "./package.json"
  },
  "files": [
    "plain-text.css",
    "plain-text-skins.css",
    "plain-text-theme.js",
    "src/measure.js",
    "system.md",
    "llms.txt",
    "skill/",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node build.js",
    "prepack": "node build.js && node scripts/sync-dist.js",
    "start": "node build.js && python3 -m http.server 4400 --directory public"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
